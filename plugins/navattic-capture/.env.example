# Settings for everything in this folder: copy to .env and fill in.
#   Claude Code's browser tools (mcp.mjs), replay.mjs, ab.mjs, start.mjs and browser.sh all read .env.
#   Variables already set in your shell win over this file.
#
# TO SWITCH MODEL OR ENDPOINT:
#   1. Change DECIDER below (and fill in that backend's section if it's empty).
#   2. In Claude Code: /mcp, then reconnect jev-browser (or start a new session).
#      replay.mjs and ab.mjs pick it up on their next run.
#   Check what's active: node ~/navattic-capture/decider.mjs

# Which decision model picks elements: openrouter | typesafe | cloudflare | custom
DECIDER=openrouter
# Optional: overrides the model of whichever DECIDER is active (otherwise that backend's *_MODEL below)
# DECIDER_MODEL=

# --- openrouter: https://openrouter.ai/keys ---
DECIDER_OPENROUTER_KEY=                            # not OPENROUTER_API_KEY, so a key set elsewhere on your Mac can't override it
OPENROUTER_MODEL=perplexity/pplx-decider-v1.2      # or typesafe/jev-1.13, or any OpenRouter decider

# --- typesafe (hosted Jev): https://console.typesafe.ai/keys ---
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# --- cloudflare (Workers AI Clef) ---
CLOUDFLARE_API_TOKEN=                              # API token with Workers AI access
CLOUDFLARE_ACCOUNT_ID=                             # in the dashboard URL after dash.cloudflare.com/
CLOUDFLARE_MODEL=clef-flash                        # clef-flash (9B, fast) or clef (27B, more precise)
# CLOUDFLARE_URL=                                  # full run URL instead of ACCOUNT_ID + MODEL

# --- custom: any endpoint that speaks the System One API ---
CUSTOM_URL=                                        # API root without /v1/systemone, e.g. http://127.0.0.1:9999
CUSTOM_API_KEY=                                    # sent as Authorization: Bearer (optional)
CUSTOM_MODEL=                                      # optional

# --- Video → prompt (video2prompt.mjs): Gemini watches a screen recording and writes the capture prompt ---
GEMINI_API_KEY=                                    # aistudio.google.com → Get API key
GEMINI_MODEL=gemini-3.5-flash                      # or gemini-3.1-pro-preview (slower, more careful)

# --- Overrides (defaults shown) ---
# CDP_PORT=9222
# JEV_DIR=        # jev-browser checkout (default ./jev-browser)
# NAVATTIC_EXT=   # extension folder (default ./extension)
# NAVATTIC_PROFILE=
# NAVATTIC_HOME only works from the shell: .env is always read from this folder.
